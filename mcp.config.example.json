{
  "mcpServers": {
    "sap-odata": {
      "type": "stdio",
      "command": "node",
      "args": ["/absolute/path/to/sap-odata-mcp-server/dist/index.js"],
      "env": {
        "SAP_ODATA_BASE_URL": "https://sap.example.com/sap/opu/odata/sap/API_SALES_ORDER_SRV",
        "SAP_CLIENT": "200",
        "SAP_USER": "service_user",
        "SAP_PASSWORD": "set-this-only-in-local-client-config",
        "SAP_TLS_REJECT_UNAUTHORIZED": "true",
        "SAP_WRITE_ENABLED": "false"
      }
    }
  }
}
