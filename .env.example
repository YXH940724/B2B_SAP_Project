# Copy this file to a protected local .env file. Never commit real SAP credentials.
# Example: cp .env.example .env && chmod 600 .env

# SAP Sales Order OData service root (replace with the approved test or production endpoint).
SAP_ODATA_BASE_URL=https://sap.example.com/sap/opu/odata/sap/API_SALES_ORDER_SRV
SAP_CLIENT=100
SAP_USER=replace-with-sap-user
SAP_PASSWORD=replace-with-sap-password

# Optional service roots. Leave commented to derive them from SAP_ODATA_BASE_URL's host.
# SAP_PRODUCT_SERVICE_URL=https://sap.example.com/sap/opu/odata/sap/API_PRODUCT_SRV
# SAP_BUSINESS_PARTNER_SERVICE_URL=https://sap.example.com/sap/opu/odata/sap/API_BUSINESS_PARTNER
# SAP_PRICING_SERVICE_URL=https://sap.example.com/sap/opu/odata/sap/API_SLSPRICINGCONDITIONRECORD_SRV

# TLS and request settings. Keep TLS verification enabled outside an approved test environment.
SAP_TLS_REJECT_UNAUTHORIZED=true
# SAP_CA_CERT_PATH=/secure/path/company-root-ca.pem
SAP_REQUEST_TIMEOUT_MS=30000

# SAP writes are disabled by default. Enable only in an approved test window.
SAP_WRITE_ENABLED=false
SAP_WRITE_ALLOWED_FIELDS=PurchaseOrderByCustomer,CustomerPurchaseOrderType,CustomerPurchaseOrderDate,DeliveryBlockReason,CustomerPaymentTerms,CustomerGroup

# Customer portal runtime. PORTAL_DB_PATH is relative to the directory where npm run start:web is executed.
NODE_ENV=development
VERIFICATION_DELIVERY=log
PORTAL_DB_PATH=data/portal.db
PORTAL_PORT=3000
PORTAL_SALES_ORDER_TYPE=OR
PORTAL_SALES_ORGANIZATION=1310
PORTAL_DISTRIBUTION_CHANNEL=10
PORTAL_DIVISION=00
