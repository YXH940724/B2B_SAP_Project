# Keep the populated file outside this repository, for example:
# ~/.config/sap-odata-mcp/.env (permission mode 600)
SAP_ODATA_BASE_URL=https://handhana01.hand-china.com:44350/sap/opu/odata/sap/API_SALES_ORDER_SRV
# Optional overrides; by default the MCP derives these services from the same SAP host.
# SAP_PRODUCT_SERVICE_URL=https://handhana01.hand-china.com:44350/sap/opu/odata/sap/API_PRODUCT_SRV
# SAP_BUSINESS_PARTNER_SERVICE_URL=https://handhana01.hand-china.com:44350/sap/opu/odata/sap/API_BUSINESS_PARTNER
# SAP_PRICING_SERVICE_URL=https://handhana01.hand-china.com:44350/sap/opu/odata/sap/API_SLSPRICINGCONDITIONRECORD_SRV
SAP_CLIENT=200
SAP_USER=15470
SAP_PASSWORD=ye123456789

# Trust the SAP server certificate in production. Do not commit certificate files.
# SAP_CA_CERT_PATH=/secure/path/company-root-ca.pem
SAP_TLS_REJECT_UNAUTHORIZED=false
SAP_REQUEST_TIMEOUT_MS=30000

# Write operations are disabled by default. Setting this to true only permits tools
# that also set dry_run=false and provide the exact confirmation phrase.
SAP_WRITE_ENABLED=false
# Comma-separated OData properties permitted in sap_update_sales_order.
SAP_WRITE_ALLOWED_FIELDS=PurchaseOrderByCustomer,CustomerPurchaseOrderType,CustomerPurchaseOrderDate,DeliveryBlockReason,CustomerPaymentTerms,CustomerGroup

# Customer order portal. Do not commit the database file.
PORTAL_DB_PATH=data/portal.db
# The storefront initially displays 20 materials per page; its server API accepts 1 through 50.
# Only accepted when NODE_ENV=development; writes the one-time code to the server log.
VERIFICATION_DELIVERY=log
PORTAL_PORT=3000
PORTAL_SALES_ORDER_TYPE=OR
PORTAL_SALES_ORGANIZATION=1000
PORTAL_DISTRIBUTION_CHANNEL=10
PORTAL_DIVISION=00
