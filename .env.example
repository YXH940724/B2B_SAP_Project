# Store the populated file outside this repository, for example:
# ~/.config/sap-hana-mcp/.env (permission mode 600)
HANA_HOST=hana.example.com
HANA_PORT=31013
HANA_USER=readonly_user
HANA_PASSWORD=replace-with-local-secret

# Optional database routing
# HANA_SCHEMA=SAPABAP1
# HANA_INSTANCE_NUMBER=10
# HANA_DATABASE_NAME=TENANTDB

# TLS and read-only safety defaults
HANA_SSL=true
HANA_ENCRYPT=true
HANA_VALIDATE_CERT=true
HANA_QUERY_LIMITS_ENABLED=true
HANA_MAX_RESULT_ROWS=50
HANA_QUERY_TIMEOUT_MS=30000
HANA_ALLOW_INSERT=false
HANA_ALLOW_UPDATE=false
HANA_ALLOW_DELETE=false
ENABLE_FILE_LOGGING=false
ENABLE_CONSOLE_LOGGING=false
